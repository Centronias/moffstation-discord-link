@page
@model MoffDiscordLink.Pages.AccessDenied

@{
    ViewData["Title"] = "Access Denied";
}

<h1 class="text-danger">Access Denied</h1>
<h2 class="text-danger">You don't have permission to view this page.</h2>

@if (Model.ReturnUrl != null)
{
    <p class="text-muted">Tried to access: <code>@Model.ReturnUrl</code></p>
}

<a asp-page="/Index" class="btn btn-primary mt-2">Go to home</a>
